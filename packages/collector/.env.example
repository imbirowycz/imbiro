# Address of the main API (Hetzner). Locally: http://localhost:3000
API_URL=https://2.31.115.87.sslip.io
# The same value as COLLECTOR_TOKEN in the server's .env
COLLECTOR_TOKEN=

# Optional
# Where Chrome keeps its profile (cookies survive restarts). Default: ./.profile
#PROFILE_DIR=
# Browser channel installed on this machine: chrome (default), chromium, msedge
#BROWSER_CHANNEL=chrome
# true = no window. Most shops block a headless browser — leave false.
#HEADLESS=false
