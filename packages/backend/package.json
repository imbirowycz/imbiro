{
  "name": "@myorg/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "tsx --import ./src/test/env.ts --test \"src/**/*.test.ts\"",
    "admin:hash": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@myorg/shared": "file:../shared",
    "argon2": "0.45.1",
    "cors": "^2.8.5",
    "cron-parser": "5.10.2",
    "express": "^4.22.3",
    "fast-xml-parser": "5.11.2",
    "jsdom": "27.4.0",
    "nodemailer": "10.1.7",
    "pg": "^8.13.1",
    "pg-boss": "12.37.1",
    "sanitize-html": "2.18.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "27.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
