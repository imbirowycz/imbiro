# Skopiuj na serwerze jako .env (plik .env nie jest wysyłany przez deploy.sh)
SITE_ADDRESS=2.31.115.87.sslip.io
POSTGRES_USER=app
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=app

# Administrator (wymagane). Hasło TYLKO jako hash Argon2id — wygeneruj go na serwerze:
#   docker compose -f docker-compose.prod.yml run --rm -it --no-deps backend node packages/backend/dist/scripts/hash-password.js
# i wklej wypisaną linię. Pojedyncze cudzysłowy są konieczne (znaki $ w hashu).
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Sesja (opcjonalne)
SESSION_TTL_HOURS=720
SESSION_IDLE_MINUTES=10080

# Worker / scheduler (opcjonalne, wartości domyślne w packages/backend/src/config.ts)
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=300
JOB_RETRY_LIMIT=3
JOB_RETRY_DELAY_SECONDS=30

# Integracje akcji schedulera (opcjonalne; bez nich akcja kończy się czytelnym błędem konfiguracji)
# email.send
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# telegram.send
TELEGRAM_BOT_TOKEN=

# Okazje: wspólny sekret API ↔ domowy zbieracz (packages/collector). Bez niego zbieracz dostaje 401.
# Wygeneruj: openssl rand -hex 32 — ta sama wartość trafia do packages/collector/.env
COLLECTOR_TOKEN=
# Limity, które serwer podaje zbieraczowi (opcjonalne; poniżej wartości domyślne)
#COLLECTOR_POLL_SECONDS=20
#COLLECTOR_DOMAIN_GAP_SECONDS=30
#COLLECTOR_PAGE_TIMEOUT_SECONDS=45
#COLLECTOR_MAX_JOBS_PER_CLAIM=3
